# SQLite database file (relative to prisma/ directory when using Prisma CLI, resolved by the app at runtime)
DATABASE_URL="file:./dev.db"

# Required: Claude API key used server-side only for all AI reasoning (setup, blueprint,
# extraction, comparison, insight agents). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the Claude model used by the agents (defaults to claude-sonnet-4-5)
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Optional: where the synced Markdown vault (one Obsidian-readable folder per
# knowledge base, auto-updated after every change) is written. Relative paths
# resolve against the project root. Defaults to "vault".
VAULT_DIR="vault"

# Deployed (Vercel) only — leave unset locally. When set, the app uses this hosted
# Turso (libSQL) database instead of the DATABASE_URL SQLite file. Apply migrations
# to it with `npm run db:migrate:turso`. Server-only secrets; never NEXT_PUBLIC_.
# TURSO_DATABASE_URL="libsql://<db>-<org>.turso.io"
# TURSO_AUTH_TOKEN="..."
# On Vercel, set VAULT_DIR="/tmp/vault" (the deployment filesystem is read-only;
# /tmp is writable but temporary, so the Markdown export is best-effort there).

# Sign-in gate (src/proxy.ts). Leave unset locally to keep local dev open; required
# in production (the app refuses requests without them). Server-only secrets.
# APP_PASSWORD="choose-a-long-passphrase"
# AUTH_SECRET="output of: openssl rand -hex 32"
